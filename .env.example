# ── Supabase ──────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key  # NEVER commit this — keep in .env.local only

# ── Application ──────────────────────────────────────────────────────
# Used for CSRF origin validation and CORS. Must match your deployment URL.
# CORS_ORIGIN=https://your-app-domain.com
# NEXT_PUBLIC_APP_URL=https://your-app-domain.com

# ── Feature Gates ─────────────────────────────────────────────────────
# Set any of these to "true" to enable the corresponding feature.
# All default to disabled so the dev environment runs with ZERO external dependencies.
NEXT_PUBLIC_ENABLE_EMAIL=false            # Resend (email sending)
NEXT_PUBLIC_ENABLE_SMS=false              # Twilio (SMS sending)
NEXT_PUBLIC_ENABLE_WEBHOOKS=false         # n8n (webhook automation)
NEXT_PUBLIC_ENABLE_EMAIL_SEQUENCES=false  # Campaign email scheduler
NEXT_PUBLIC_ENABLE_WORKFLOW_EDITOR=false  # Visual workflow editor
NEXT_PUBLIC_ENABLE_CALENDAR_SYNC=false    # Google Calendar OAuth sync
NEXT_PUBLIC_ENABLE_PORTAL=false           # Customer portal (auth, shares)
NEXT_PUBLIC_ENABLE_REALTIME=false         # Supabase Realtime (WebSocket push)
NEXT_PUBLIC_ENABLE_INVOICES=true          # Core CRM feature, enabled by default
NEXT_PUBLIC_ENABLE_STANDALONE_INVOICE=false # Standalone invoice form

# ── Supabase Realtime ────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_REALTIME_ENABLED=true

# ── Resend (Email) ───────────────────────────────────────────────────
# The API key is read from the server environment. The client NEVER has access.
RESEND_API_KEY=re_YOUR_API_KEY
RESEND_FROM_EMAIL=crm@yourdomain.com
RESEND_FROM_NAME=NexusCRM
# Secret for verifying Resend webhook callbacks (inbound email events)
# RESEND_WEBHOOK_SECRET=your-webhook-secret

# ── Client-Side Defaults (overridable per user) ─────────────────────
# NEXT_PUBLIC_DEFAULT_FROM_EMAIL=crm@yourdomain.com
# NEXT_PUBLIC_DEFAULT_SMS_FROM=+15551234567

# ── Twilio (SMS) ─────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=your_account_sid
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_FROM_NUMBER=+15551234567

# ── n8n Automation ──────────────────────────────────────────────────
# N8N_WEBHOOK_URL=https://your-n8n-instance.com/webhook
# N8N_WEBHOOK_SECRET=your-webhook-secret

# ── Google Calendar OAuth ──────────────────────────────────────────
# Create OAuth 2.0 credentials at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-client-id
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/integrations/google/callback
# Key used to encrypt OAuth tokens at rest (AES-256-GCM). Generate via: openssl rand -hex 32
# GOOGLE_TOKEN_ENCRYPTION_KEY=your-32-byte-hex-key
# Falls back to SUPABASE_SERVICE_ROLE_KEY if unset — recommended to set a dedicated key.
# ── Cron / Scheduled Jobs ───────────────────────────────────────────
# Used to authenticate cron-triggered API calls (e.g., campaign processing)
# CRON_SECRET=your-cron-secret
